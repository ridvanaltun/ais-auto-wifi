<?xml version="1.0" encoding="UTF-8"?>
<!--
  AIS Wi-Fi Auto-Login — start automatically at login (LaunchAgent).

  SETUP:
  1) Replace the two PATHS below with the ones on your machine:
       - /usr/bin/python3            -> output of `which python3`
       - /FULL/PATH/TO/ais-wifi-autologin -> full path of this folder (`pwd`)
  2) Copy this file:
       cp com.aiswifi.autologin.plist ~/Library/LaunchAgents/
  3) Load and start it:
       launchctl load  ~/Library/LaunchAgents/com.aiswifi.autologin.plist
  NOTE: To read the SMS OTP from Messages, Full Disk Access must be granted to
  THIS python3 (Terminal's permission does not apply when started by launchd).
  To stop / remove:
       launchctl unload ~/Library/LaunchAgents/com.aiswifi.autologin.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aiswifi.autologin</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/FULL/PATH/TO/ais-wifi-autologin/run.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/FULL/PATH/TO/ais-wifi-autologin</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/aiswifi.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/aiswifi.err.log</string>
</dict>
</plist>
